@using SFA.DAS.FindEpao.Web.Infrastructure
@using SFA.DAS.FindEpao.Web.Models
@model ChooseCourseViewModel
@{
    ViewData["Title"] = "What is the apprenticeship training course?";
    if (ViewData.ModelState.ErrorCount > 0)
    {
        ViewData["Title"] = "Error: What is the apprenticeship training course?";
    }
    ViewData["Description"] = "Enter an apprenticeship training course to find available end-point assessment organisations.";

    var modelStateKey = "SelectedCourseId";
    var hasError = ViewData.ModelState.ContainsKey(modelStateKey) && ViewData.ModelState[modelStateKey].Errors.Any();

    // IDs used in aria-describedby
    var hintId = "choose-course-hint";
    var jsErrorId = "course-error-js";
    var noJsErrorId = "course-error-nojs";

}

<main class="govuk-main-wrapper govuk-main-wrapper--auto-spacing" id="main-content" role="main">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <partial name="_pageErrorsOverview" />
            <h1 class="govuk-heading-xl ">What is the apprenticeship training course?</h1>
            <form method="post" asp-route="@RouteNames.ChooseCourse" class="validate-auto-complete">
                <div class="govuk-form-group @(ViewData.ModelState.IsValid ? "" : "govuk-form-group--error")">
                    @if (hasError)
                    {
                        <div class="govuk-!-margin-bottom-3">
                            <span id="@jsErrorId" class="govuk-error-message das-js-show--inline">
                                <span class="govuk-visually-hidden">Error:</span>
                                @ViewData.ModelState["SelectedCourseId"].Errors.First().ErrorMessage
                            </span>
                            <span id="@noJsErrorId" class="govuk-error-message das-js-hide">
                                <span class="govuk-visually-hidden">Error:</span>
                                @ViewData.ModelState["SelectedCourseIdNoJs"].Errors.First().ErrorMessage
                            </span>
                        </div>
                    }

                    <label class="govuk-label govuk-visually-hidden" id="SelectedCourseId-label" for="SelectedCourseId"> <!-- P2-3071 BUG FIX -->
                        Select an apprenticeship training course
                    </label>
                   
                    <div id="@hintId" class="govuk-hint govuk-visually-hidden">
                        Start typing at least 3 characters, then choose a course from the list.
                    </div>

                    <select id="SelectedCourseId" 
                            name="SelectedCourseId" 
                            class="govuk-select"
                            aria-describedby="@(hasError ? $"{hintId} {jsErrorId} {noJsErrorId}" : hintId)"
                            @(hasError ? "aria-invalid=\"true\"" : null)>
                        <option value="">Select an apprenticeship training course</option>
                        @foreach (var course in Model.Courses)
                        {
                            <option value="@course.Id">@course.Description</option>
                        }
                    </select>
                </div>

                <!-- P2-3071 BUG FIX -->

                <!-- Added to be read by the js files -->
                <div id="autocomplete-metadata"
                     data-has-error="@hasError.ToString().ToLower()">
                </div>

                <button class="govuk-button" type="submit">Continue</button>
            </form>
        </div>
    </div>
</main>
